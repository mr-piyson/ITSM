{"nodes": [{"id": "docs_azure_auth_proxy_redirect_fix_doc", "label": "Fix: Azure login redirecting to localhost:3000", "file_type": "document", "source_file": "docs/azure-auth-proxy-redirect-fix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_azure_auth_proxy_redirect_fix_azure_login_redirect_flow", "label": "Microsoft Azure OAuth login callback flow", "file_type": "concept", "source_file": "docs/azure-auth-proxy-redirect-fix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_azure_auth_proxy_redirect_fix_app_url_env_variable", "label": "APP_URL public base URL environment variable", "file_type": "concept", "source_file": "docs/azure-auth-proxy-redirect-fix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_azure_auth_proxy_redirect_fix_apache_reverse_proxy", "label": "Apache reverse proxy in front of Next.js", "file_type": "concept", "source_file": "docs/azure-auth-proxy-redirect-fix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_azure_auth_proxy_redirect_fix_nextjs_request_url_internal", "label": "Next.js request.url is internal behind a proxy", "file_type": "rationale", "source_file": "docs/azure-auth-proxy-redirect-fix.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Next.js Route Handlers build request.url from the internal proxy URL and do not reliably honour forwarded Host/X-Forwarded headers, so request.url must be treated as internal-only when self-hosting behind a reverse proxy."}, {"id": "docs_azure_auth_proxy_redirect_fix_redirect_from_app_url_fix", "label": "Build absolute redirects from env.APP_URL", "file_type": "rationale", "source_file": "docs/azure-auth-proxy-redirect-fix.md", "source_locati