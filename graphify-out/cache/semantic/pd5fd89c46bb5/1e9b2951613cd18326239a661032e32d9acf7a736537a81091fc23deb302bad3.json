{"nodes": [{"id": "docs_reports_dcc_connectivity_report_2026_09_10_doc", "label": "DCC & Card Reader Connectivity Report - 10 September 2026", "file_type": "document", "source_file": "docs/reports/dcc-connectivity-report-2026-09-10.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_reports_dcc_connectivity_report_2026_09_10_dcc_station_fleet", "label": "32 DCC stations (Raspberry Pi + card reader)", "file_type": "concept", "source_file": "docs/reports/dcc-connectivity-report-2026-09-10.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_reports_dcc_connectivity_report_2026_09_10_dcc_connectivity_logs", "label": "dcc_connectivity_logs monitoring table", "file_type": "concept", "source_file": "docs/reports/dcc-connectivity-report-2026-09-10.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_reports_dcc_connectivity_report_2026_09_10_dcc_cron_connectivity_check", "label": "Cron task pinging every DCC and card reader", "file_type": "concept", "source_file": "docs/reports/dcc-connectivity-report-2026-09-10.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_reports_dcc_connectivity_report_2026_09_10_dccs_realtime_dashboard", "label": "DCCs dashboard and realtime view", "file_type": "concept", "source_file": "docs/reports/dcc-connectivity-report-2026-09-10.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_reports_dcc_connectivity_report_2026_09_10_rollout_verdict_not_ready", "label": "Rollout verdict: not ready", "file_type": "rationale", "source_file": "docs/reports/dcc-connectivity-report-2026-09-10.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only 21.4% of 7,507 checks passed, 17 of 32 DCCs never passed a single check, and no station met the 99% uptime bar, so connectivity is not stable enough to go live before remediation."}, {"id": "docs_reports_dcc_connectivity_report_2026_09_10_shared_path_failure_mode", "label": "Shared-path failure mode (both devices down)", "file_type": "concept", "source_file": "docs/reports/dcc-connectivity-report-2026-09-10.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_reports_dcc_connectivity_report_2026_09_10_card_reader_wifi_weak_point", "label": "Card reader WiFi weak point", "file_type": "concept", "source_file": "docs/reports/dcc-connectivity-report-2026-09-10.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_reports_dcc_connectivity_report_2026_09_10_pi_side_instability", "label": "DCC/Raspberry Pi side instability", "file_type": "concept", "source_file": "docs/reports/dcc-connectivity-report-2026-09-10.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_reports_dcc_connectivity_report_2026_09_10_monitoring_coverage_gap", "label": "Monitoring coverage gap (7 of 24 hours)", "file_type": "concept", "source_file": "docs/reports/dcc-connectivity-report-2026-09-10.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_reports_dcc_connectivity_report_2026_09_10_ping_latency_gap", "label": "Ping latency missing on reachable results", "file_type": "concept", "source_file": "docs/reports/dcc-connectivity-report-2026-09-10.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_reports_dcc_connectivity_report_2026_09_10_reader_direct_power_data_cable", "label": "Solution A: card reader wired to Pi over power cable", "file_type": "concept", "source_file": "docs/reports/dcc-connectivity-report-2026-09-10.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evidence: readers answered in only 32.8% of checks, 15 DCCs never answered from the reader side, and on several stations the Pi worked while the reader did not; one cable would deliver power and data together and remove the WiFi dependency."}, {"id": "docs_reports_dcc_connectivity_report_2026_09_10_pi_direct_ethernet", "label": "Solution B: direct Ethernet for Raspberry Pi", "file_type": "concept", "source_file": "docs/reports/dcc-connectivity-report-2026-09-10.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evidence: DCC/Pi reachable in only 32.9% of checks and 14 DCCs never answered from the Pi side; direct Ethernet removes shared radio conditions but requires cabling all 32 locations and limits moving the DCC."}, {"id": "docs_reports_dcc_connectivity_report_2026_09_10_external_usb_wifi_antenna", "label": "Solution B alt: external USB WiFi antenna", "file_type": "concept", "source_file": "docs/reports/dcc-connectivity-report-2026-09-10.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cheaper and quicker than cabling the factory, keeps the DCC mobile and positions the antenna outside the metal cabinet, but it is a signal fix rather than a link fix since WiFi and AP coverage remain."}, {"id": "docs_reports_dcc_connectivity_report_2026_09_10_live_kiosk_software_update", "label": "Solution C: live kiosk software update", "file_type": "concept", "source_file": "docs/reports/dcc-connectivity-report-2026-09-10.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hardware changes alone will not help if the live kiosk software still assumes the old WiFi path - endpoint/address config, reader-to-Pi communication, reconnection and fallback must move together with the wiring."}, {"id": "docs_reports_dcc_connectivity_report_2026_09_10_rollout_gate_criteria", "label": "Rollout gate criteria", "file_type": "concept", "source_file": "docs/reports/dcc-connectivity-report-2026-09-10.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_reports_dcc_connectivity_report_2026_09_10_doc", "target": "docs_reports_dcc_connectivity_report_2026_09_10_dcc_station_fleet", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/reports/dcc-connectivity-report-2026-09-10.html", "source_location": null, "weight": 1}, {"source": "docs_reports_dcc_connectivity_report_2026_09_10_doc", "target": "docs_reports_dcc_connectivity_report_2026_09_10_dcc_connectivity_logs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/reports/dcc-connectivity-report-2026-09-10.html", "source_location": null, "weight": 1}, {"source": "docs_reports_dcc_connectivity_report_2026_09_10_doc", "target": "docs_reports_dcc_connectivity_report_2026_09_10_dcc_cron_connectivity_check", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/reports/dcc-connectivity-report-2026-09-10.html", "source_location": null, "weight": 1}, {"source": "docs_reports_dcc_connectivity_report_2026_09_10_doc", "target": "docs_reports_dcc_connectivity_report_2026_09_10_dccs_realtime_dashboard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/reports/dcc-connectivity-report-2026-09-10.html", "source_location": null, "weight": 1}, {"source": "docs_reports_dcc_connectivity_report_2026_09_10_doc", "target": "docs_reports_dcc_connectivity_report_2026_09_10_rollout_verdict_not_ready", "relation": "references", "confidence": "EXTRACT